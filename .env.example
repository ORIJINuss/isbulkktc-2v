# ---------- Supabase ----------
# Real job/company data requires valid Supabase values in local development as well as production.
# ZORUNLU (üretim) · lib/ortam/ortam.ts, middleware.ts, app/api/hazirlik
NEXT_PUBLIC_SUPABASE_URL="https://ORNEK.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi...ANON_ANAHTAR"

# ZORUNLU (üretim) · yalnızca sunucu tarafı; ASLA istemciye sızdırma
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi...SERVICE_ROLE_ANAHTAR"

# ---------- Cloudflare Turnstile (bot koruması) ----------
# ZORUNLU (üretim) · lib/ortam/ortam.ts, bilesenler/genel/TurnstileBileseni.tsx
