{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.schema.json",
  "title": "Orchestrator task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "acceptanceCriteria",
    "createdAt",
    "updatedAt",
    "state",
    "attempt",
    "maxAttempts",
    "retryableFailure",
    "owner",
    "risk",
    "riskReasons",
    "requiresHumanApproval",
    "files",
    "dependencies",
    "currentAgent",
    "lastError",
    "evidenceIds",
    "reviewIds",
    "parentTaskId",
    "correlationId",
    "idempotencyKey",
    "opencode",
    "cline",
    "reviewIteration"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string" },
    "acceptanceCriteria": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "state": { "type": "string" },
    "attempt": { "type": "integer", "minimum": 1 },
    "maxAttempts": { "type": "integer", "minimum": 1 },
    "retryableFailure": { "type": "boolean" },
    "owner": { "type": "string", "enum": ["CHIEF", "OPENCODE", "CLINE"] },
    "risk": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "riskReasons": { "type": "array", "items": { "type": "string" } },
    "requiresHumanApproval": { "type": "boolean" },
    "files": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "currentAgent": { "type": ["string", "null"] },
    "lastError": { "type": ["string", "null"] },
    "evidenceIds": { "type": "array", "items": { "type": "string" } },
    "reviewIds": { "type": "array", "items": { "type": "string" } },
    "parentTaskId": { "type": ["string", "null"] },
    "correlationId": { "type": "string", "minLength": 1 },
    "idempotencyKey": { "type": ["string", "null"] },
    "opencode": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "sessionId",
        "projectId",
        "providerId",
        "modelId",
        "worktree",
        "agent",
        "readOnly",
        "createdAt",
        "attempt",
        "promptMessageId",
        "messageId"
      ],
      "properties": {
        "sessionId": { "type": "string", "minLength": 1 },
        "projectId": { "type": "string", "minLength": 1 },
        "providerId": { "type": "string", "minLength": 1 },
        "modelId": { "type": "string", "minLength": 1 },
        "worktree": { "type": "string", "minLength": 1 },
        "agent": { "type": "string", "minLength": 1 },
        "readOnly": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "attempt": { "type": "integer", "minimum": 1 },
        "promptMessageId": { "type": "string", "pattern": "^msg" },
        "messageId": { "type": ["string", "null"] }
      }
    },
    "cline": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "sessionId",
        "reviewId",
        "correlationId",
        "reviewIteration",
        "startedAt",
        "status",
        "readOnly",
        "promptHash"
      ],
      "properties": {
        "sessionId": { "type": ["string", "null"] },
        "reviewId": { "type": "string", "minLength": 1 },
        "correlationId": { "type": "string", "minLength": 1 },
        "reviewIteration": { "type": "integer", "minimum": 1, "maximum": 3 },
        "startedAt": { "type": "string", "format": "date-time" },
        "status": {
          "type": "string",
          "enum": [
            "DISPATCHING",
            "SESSION_CREATED",
            "REVIEW_RECEIVED",
            "CLINE_TIMEOUT",
            "CLINE_UNAVAILABLE",
            "CLINE_RECOVERY_FAILED",
            "CLINE_SESSION_FAILED",
            "REVIEW_PARSE_FAILED",
            "REVIEWER_WRITE_VIOLATION",
            "REVIEWER_EXECUTION_VIOLATION"
          ]
        },
        "readOnly": { "type": "boolean", "enum": [true] },
        "promptHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "reviewIteration": { "type": "integer", "minimum": 0, "maximum": 3 }
  }
}
