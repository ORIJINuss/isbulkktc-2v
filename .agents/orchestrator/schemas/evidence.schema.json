{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence.schema.json",
  "title": "Orchestrator evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "taskId",
    "correlationId",
    "type",
    "command",
    "exitCode",
    "startedAt",
    "finishedAt",
    "stdout",
    "stderr",
    "filesChanged",
    "gitStatus",
    "hash",
    "source"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": [
        "COMMAND",
        "GIT_STATUS",
        "GIT_DIFF",
        "TEST",
        "LINT",
        "TYPECHECK",
        "KALITE",
        "BUILD",
        "REVIEW",
        "AGENT_REVIEW",
        "AGENT_RESPONSE",
        "OPENCODE_ATTEMPT",
        "LOCK",
        "RECOVERY"
      ]
    },
    "command": { "type": "string" },
    "workingDirectory": { "type": "string" },
    "exitCode": { "type": ["integer", "null"] },
    "status": {
      "type": "string",
      "enum": [
        "TYPECHECK_PASS",
        "TYPECHECK_FAIL",
        "LINT_PASS",
        "LINT_FAIL",
        "KALITE_PASS",
        "KALITE_FAIL",
        "BUILD_PASS",
        "BUILD_FAIL",
        "SESSION_CREATED",
        "PROMPT_DISPATCHED",
        "RETRYABLE_FAILURE",
        "OPENCODE_TIMEOUT",
        "RESPONSE_RECEIVED",
        "REVIEW_RECEIVED",
        "REVIEW_PARSE_FAILED",
        "REVIEWER_WRITE_VIOLATION",
        "REVIEWER_EXECUTION_VIOLATION",
        "CLINE_TIMEOUT",
        "CLINE_UNAVAILABLE",
        "CLINE_RECOVERY_FAILED",
        "CLINE_SESSION_FAILED",
        "DISPATCH_FAILED",
        "TIMEOUT",
        "ERROR"
      ]
    },
    "durationMs": { "type": "integer", "minimum": 0 },
    "agent": { "type": "string" },
    "sessionId": { "type": "string" },
    "messageId": { "type": "string" },
    "promptMessageId": { "type": "string", "pattern": "^msg" },
    "promptMessageId": { "type": "string", "pattern": "^msg" },
    "providerId": { "type": "string" },
    "modelId": { "type": "string" },
    "projectId": { "type": "string" },
    "worktree": { "type": "string" },
    "attempt": { "type": "integer", "minimum": 1 },
    "retryAfterMs": { "type": "integer", "minimum": 0 },
    "response": { "type": "string" },
    "errorCode": { "type": "string" },
    "httpStatus": { "type": "integer", "minimum": 100, "maximum": 599 },
    "sessionStatus": { "type": "string" },
    "modelChangedFrom": { "type": "string" },
    "errorCode": { "type": "string" },
    "httpStatus": { "type": "integer", "minimum": 100, "maximum": 599 },
    "sessionStatus": { "type": "string" },
    "modelChangedFrom": { "type": "string" },
    "reviewId": { "type": "string", "minLength": 1 },
    "verdict": { "type": "string", "enum": ["PASS", "FAIL"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "category", "file", "line", "issue", "evidence", "recommendation"],
        "properties": {
          "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"] },
          "category": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": ["integer", "null"], "minimum": 1 },
          "issue": { "type": "string" },
          "evidence": { "type": "string" },
          "recommendation": { "type": "string" }
        }
      }
    },
    "summary": { "type": "string" },
    "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
    "changedFiles": { "type": "array", "items": { "type": "string" } },
    "qualityGateEvidenceIds": { "type": "array", "items": { "type": "string" } },
    "buildEvidenceId": { "type": "string", "minLength": 1 },
    "criticalIssues": { "type": "integer", "minimum": 0 },
    "majorIssues": { "type": "integer", "minimum": 0 },
    "minorIssues": { "type": "integer", "minimum": 0 },
    "permissionViolations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution", "write", "unknownTools"],
      "properties": {
        "execution": { "type": "array", "items": { "type": "string" } },
        "write": { "type": "array", "items": { "type": "string" } },
        "unknownTools": { "type": "array", "items": { "type": "string" } }
      }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "stdout": { "type": "string" },
    "stderr": { "type": "string" },
    "filesChanged": { "type": "array", "items": { "type": "string" } },
    "gitStatus": { "type": "string" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source": { "type": "string", "minLength": 1 }
  }
}
